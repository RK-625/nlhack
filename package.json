{
  "name": "bot-company",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "tsx --env-file=.env src/index.ts",
    "serve": "tsx --env-file=.env src/server.ts",
    "web:build": "npm --prefix web run build",
    "start:prod": "NODE_ENV=production tsx --env-file=.env src/server.ts",
    "typecheck": "tsc",
    "seed": "tsx --env-file-if-exists=.env src/auth/seed.ts",
    "cfo:register": "tsx --env-file-if-exists=.env src/cfo/register.ts"
  },
  "dependencies": {
    "@mastra/ai-sdk": "^1.10.7",
    "@mastra/core": "^1.75.0",
    "@mastra/libsql": "^1.25.1",
    "@mastra/mcp": "^2.2.0",
    "@mastra/memory": "^1.36.0",
    "@opentelemetry/api": "^1.9.1",
    "ai": "^7.0.137",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "neatlogs": "^1.1.28",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "mastra": "^1.33.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
