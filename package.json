{
  "name": "nlhack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "tsx --env-file=.env src/index.ts",
    "bot": "tsx --env-file=.env src/server.ts",
    "tunnel": "node --env-file=.env -e \"const r = require('node:child_process').spawnSync('ngrok', ['http', process.env.PORT || '3000', '--url', 'https://' + process.env.NGROK_DOMAIN], { stdio: 'inherit' }); if (r.error) throw r.error; process.exit(r.status ?? 1)\"",
    "tunnel:local": "npx --yes localtunnel --port 3000 --local-host 127.0.0.1 --subdomain nlhack-rithesh-bot",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@chat-adapter/state-memory": "^4.41.1",
    "@chat-adapter/whatsapp": "^4.41.1",
    "@mastra/core": "^1.75.0",
    "chat": "^4.41.1",
    "neatlogs": "^1.1.28",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mastra": "^1.33.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
