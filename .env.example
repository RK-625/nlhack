# Model Provider (DeepSeek used by Mastra agents)
DEEPSEEK_API_KEY=

# NeatLogs Observability & Tracing (also authenticates the Neatlogs Agent's MCP connection)
NEATLOGS_API_KEY=
# Optional: defaults to https://ingest.neatlogs.com
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
NEATLOGS_DEBUG=false
# Optional: trace link template for the usage row; auto-detected from the key's whoami (org/project) when unset
# NEATLOGS_TRACE_URL=https://app.neatlogs.com/traces/{traceId}?orgId=...&projectId=...

# Crustdata Market Research Tools
CRUSTDATA_API_KEY=

# GitHub agent (fine-grained PAT; read scopes to inspect, write scopes to make approved changes; used against GitHub's remote MCP server)
GITHUB_PAT=

# Server Port (optional, defaults to 3000)
PORT=3000

# Auth (Better Auth) — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (cookies + CSRF checks are tied to it)
BETTER_AUTH_URL=http://localhost:3000
# Directory for SQLite files (auth.db, later mastra.db); defaults to ./data
DATA_DIR=./data

# cfo.ai per-user OAuth connection (optional; routes answer 503 until both are set)
# Public client id from one-time registration: run `npm run cfo:register` and paste the printed value
CFO_OAUTH_CLIENT_ID=
# AES-256-GCM key for cfo.ai tokens at rest (32 bytes, base64 or hex) — generate with: openssl rand -base64 32
# Changing it invalidates stored connections (users reconnect)
CFO_TOKEN_KEY=
# Optional public origin for the OAuth redirect URI; defaults to BETTER_AUTH_URL
# APP_URL=http://localhost:3000
