# Model Provider (DeepSeek used by Mastra agents)
DEEPSEEK_API_KEY=

# NeatLogs Observability & Tracing
NEATLOGS_API_KEY=
# Optional: defaults to https://ingest.neatlogs.com
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
NEATLOGS_DEBUG=false

# Crustdata Market Research Tools
CRUSTDATA_API_KEY=

# GitHub read-only agent (fine-grained PAT with read access; used against GitHub's remote MCP server)
GITHUB_PAT=

# Server Port (optional, defaults to 3000)
PORT=3000

# Stable ngrok tunnel: use your account's assigned dev domain (hostname only).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# WhatsApp Business Cloud API (Meta Graph API)
# Get from Meta for Developers -> Your App -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Auth (Better Auth) — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (cookies + CSRF checks are tied to it)
BETTER_AUTH_URL=http://localhost:3000
# Directory for SQLite files (auth.db, later mastra.db); defaults to ./data
DATA_DIR=./data
